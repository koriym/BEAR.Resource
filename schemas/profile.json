{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bearsunday.github.io/BEAR.Resource/schemas/profile.json",
  "title": "BEAR.Resource Profile Data",
  "description": "Schema for profiling data collected during resource processing within the BEAR.Resource framework",
  "links": [
    {
      "rel": "describedby",
      "href": "https://xdebug.org/docs/trace#Output-Formats",
      "title": "Xdebug Trace Output Formats"
    },
    {
      "rel": "describedby", 
      "href": "https://github.com/tideways/php-xhprof-extension?tab=readme-ov-file#data-format",
      "title": "XHProf Data Format Documentation"
    }
  ],
  "type": "object",
  "properties": {
    "xhprof": {
      "oneOf": [
        {
          "type": "array",
          "maxItems": 0,
          "description": "Empty array when XHProf is not available"
        },
        {
          "type": "object",
          "properties": {
            "profile_data": {
              "type": "object",
              "description": "Raw XHProf profiling data with function call metrics. Captures statistical performance data (wall time, memory usage, call counts) with low overhead, enabling production-ready performance monitoring unlike more intrusive tracing methods.",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "wt": {
                    "type": "integer",
                    "description": "Wall time in microseconds"
                  },
                  "mu": {
                    "type": "integer", 
                    "description": "Memory usage in bytes"
                  },
                  "pmu": {
                    "type": "integer",
                    "description": "Peak memory usage in bytes"
                  },
                  "ct": {
                    "type": "integer",
                    "description": "Call count"
                  }
                }
              }
            },
            "analysis": {
              "type": "object",
              "description": "Auto-generated analysis of XHProf data for AI consumption",
              "properties": {
                "generated_by": {
                  "type": "string",
                  "description": "Tool/component that generated this analysis (e.g., 'BEAR\\Resource\\SemanticLog\\Profile\\XHProfResult::generateAnalysis')"
                },
                "generated_at": {
                  "type": "string",
                  "format": "date-time",
                  "description": "Timestamp when analysis was generated"
                },
                "criteria": {
                  "type": "object",
                  "description": "Analysis criteria and thresholds used",
                  "properties": {
                    "bottleneck_threshold_microseconds": {
                      "type": "integer",
                      "description": "Minimum wall time in microseconds to be considered a bottleneck"
                    }
                  }
                },
                "summary": {
                  "type": "object",
                  "properties": {
                    "total_wall_time_microseconds": {"type": "integer"},
                    "total_memory_usage_bytes": {"type": "integer"},
                    "function_count": {"type": "integer"}
                  }
                },
                "top_functions": {
                  "type": "array",
                  "description": "Functions sorted by wall time (descending)"
                },
                "bottlenecks": {
                  "type": "array",
                  "description": "Functions exceeding bottleneck threshold"
                }
              },
              "required": ["generated_by"]
            }
          },
          "additionalProperties": false
        }
      ],
      "description": "XHProf performance profiling data with embedded analysis"
    },
    "xdebug": {
      "oneOf": [
        {
          "type": "array",
          "maxItems": 0,
          "description": "Empty array when Xdebug trace is not available"
        },
        {
          "type": "object",
          "properties": {
            "trace_content": {
              "type": "string",
              "description": "Raw Xdebug trace file content in trace format 4. Provides granular execution flow beyond PHP's standard debug_backtrace(), capturing function entry/exit with precise timestamps, memory usage, and call depth for comprehensive performance analysis and bottleneck identification."
            },
            "analysis": {
              "type": "object",
              "description": "Auto-generated analysis of Xdebug trace data for AI consumption",
              "properties": {
                "generated_by": {
                  "type": "string",
                  "description": "Tool/component that generated this analysis (e.g., 'BEAR\\Resource\\SemanticLog\\Profile\\XdebugTrace::generateAnalysis')"
                },
                "generated_at": {
                  "type": "string",
                  "format": "date-time",
                  "description": "Timestamp when analysis was generated"
                },
                "criteria": {
                  "type": "object",
                  "description": "Analysis criteria and thresholds used",
                  "properties": {
                    "bottleneck_threshold": {
                      "type": "integer",
                      "description": "Minimum call count to be considered a bottleneck"
                    }
                  }
                },
                "summary": {
                  "type": "object",
                  "properties": {
                    "total_function_calls": {"type": "integer"},
                    "unique_functions": {"type": "integer"},
                    "max_call_depth": {"type": "integer"},
                    "trace_lines": {"type": "integer"}
                  }
                },
                "most_called_functions": {
                  "type": "object",
                  "description": "Functions with their call counts"
                },
                "execution_flow": {
                  "type": "object",
                  "properties": {
                    "entry_points": {
                      "type": "array",
                      "description": "First few function calls"
                    },
                    "bottlenecks": {
                      "type": "object",
                      "description": "Functions exceeding bottleneck threshold"
                    }
                  }
                }
              },
              "required": ["generated_by"]
            }
          },
          "additionalProperties": false
        }
      ],
      "description": "Xdebug execution trace data with embedded content and analysis. Provides detailed function-by-function execution flow that standard PHP profiling cannot capture, essential for identifying complex performance issues, recursive calls, and execution path bottlenecks."
    },
    "php": {
      "type": "object",
      "properties": {
        "backtrace": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "function": {
                "type": "string",
                "description": "Function name"
              },
              "file": {
                "type": "string",
                "description": "File path"
              },
              "line": {
                "type": "integer",
                "description": "Line number"
              },
              "class": {
                "type": "string",
                "description": "Class name (if applicable)"
              },
              "type": {
                "type": "string",
                "enum": ["::", "->"],
                "description": "Method call type"
              }
            },
            "required": ["function"],
            "additionalProperties": true
          },
          "description": "PHP backtrace information"
        }
      },
      "required": ["backtrace"],
      "description": "PHP-level profiling data using debug_backtrace()"
    }
  },
  "additionalProperties": false
}