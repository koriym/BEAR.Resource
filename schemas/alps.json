          "value": "Performance profiling that captures both raw metrics and semantic context, enabling AI to understand the meaning behind performance data."
        }
      },
      {
        "id": "tim-berners-lee-vision",
        "type": "semantic",
        "title": "Tim Berners-Lee's Vision",
