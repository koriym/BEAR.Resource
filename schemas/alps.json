      },
      {
        "id": "semantic-portal-template",
        "type": "semantic",
        "title": "Semantic Portal Template",
        "doc": {
          "value": "Reusable template system for creating semantic web portals that enable AI to understand project structures and documentation."
        }
      },
      {
        "id": "ai-powered-performance-analysis",
        "type": "semantic",
        "title": "AI-Powered Performance Analysis",
        "doc": {
          "value": "Automated analysis of performance profiling data using artificial intelligence to identify bottlenecks, patterns, and optimization opportunities."
