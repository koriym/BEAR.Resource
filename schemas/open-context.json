{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bearsunday.github.io/BEAR.Resource/schemas/open-context.json",
  "title": "BEAR.Resource Open Context",
  "description": "Schema for resource request initiation context with profiling start",
  "type": "object",
  "required": ["id", "type", "$schema", "context"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for this context"
    },
    "type": {
      "type": "string",
      "const": "bear_resource_request",
      "description": "Context type identifier"
    },
    "$schema": {
      "type": "string",
      "format": "uri",
      "description": "JSON Schema URL for this context"
    },
    "context": {
      "type": "object",
      "required": ["method", "uri", "profile"],
      "properties": {
        "method": {
          "type": "string",
          "enum": ["GET", "POST", "PUT", "DELETE", "PATCH", "HEAD", "OPTIONS"],
          "description": "HTTP method for the resource request"
        },
        "uri": {
          "type": "string",
          "description": "Resource URI being requested"
        },
        "profile": {
          "$ref": "https://bearsunday.github.io/BEAR.Resource/schemas/profile.json",
          "description": "Profiling data collected at request start"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}